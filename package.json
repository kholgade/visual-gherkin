{
  "name": "visual-gherkin",
  "version": "1.0.0",
  "description": "Visualize Gherkin/feature files as interactive metro-style maps",
  "main": "dist/server/index.js",
  "scripts": {
    "start-dev": "lsof -ti:3001,5173 | xargs kill -9 2>/dev/null; npm run build && npm start",
    "dev": "concurrently \"tsc && nodemon dist/server/index.js\" \"vite\"",
    "clean": "rm -rf dist && find src \\( -name '*.js' -o -name '*.js.map' -o -name '*.d.ts' -o -name '*.d.ts.map' \\) | xargs rm -f",
    "build": "npm run clean && tsc && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview"
  },
  "keywords": [
    "gherkin",
    "feature",
    "visualization",
    "bdd"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "gherkin": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "playwright": "^1.58.2",
    "terser": "^5.46.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
